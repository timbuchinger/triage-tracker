# OpenTelemetry / Honeycomb configuration example
# Copy values into your `backend/.env` (or use secret manager) before running.

# Honeycomb API key
HONEYCOMB_API_KEY=<YOUR_HONEYCOMB_API_KEY>

# Honeycomb dataset name
HONEYCOMB_DATASET=<YOUR_HONEYCOMB_DATASET>

# OTLP endpoint (defaults to Honeycomb OTLP HTTP endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces

# Optional: service name used in resource attributes
OTEL_SERVICE_NAME=triage-tracker-api

# You can also set a combined resource attribute string if desired
# OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,service.environment=development
