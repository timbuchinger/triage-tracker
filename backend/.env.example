# Example environment variables for Triage Tracker (backend)
# Copy or reference these when creating your local `backend/.env` or in your secrets manager.

# Database
DATABASE_URL="postgresql://triage:triage_password@localhost:15432/triage?schema=public"

# Redis
REDIS_URL="redis://localhost:16379"

# App
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Worker
WORKER_POLL_INTERVAL_MS=60000

# Slack (OAuth & signing)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Optional App-level token (required for Socket Mode if used)
# SLACK_APP_TOKEN=xapp-your-app-level-token

# Note: For production/ngrok deployments, set FRONTEND_URL to your public-facing URL
# and SLACK_REDIRECT_URI to match the callback URL configured in your Slack app manifest

# Required OAuth bot scopes (add these in Slack App → OAuth & Permissions):
# commands, chat:write, chat:write.public, conversations.history, reactions:read,
# conversations:write (or channels:manage) — covers create, invite, setTopic, join
# users:read

# OpenTelemetry / Honeycomb
# Honeycomb API key (secret)
HONEYCOMB_API_KEY=<YOUR_HONEYCOMB_API_KEY>
# Honeycomb dataset name
HONEYCOMB_DATASET=<YOUR_HONEYCOMB_DATASET>
# OTLP endpoint (defaults to Honeycomb OTLP HTTP endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces
# Service name prefix used to derive per-process service names
# The API will append `-api` and the worker will append `-worker`.
OTEL_SERVICE_NAME_PREFIX=triage-tracker

# Optional: set an explicit full service name to override the derived value
# OTEL_SERVICE_NAME=triage-tracker-api

# Optional resource attributes
# OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,service.environment=development
